# Python caches and environments
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter notebooks
.ipynb_checkpoints/

# Secrets and local environment variables
.env
.env.*
*.pem
*.key

# Raw and derived datasets (never commit large datasets or local snapshots)
data/raw/*
!data/raw/.gitkeep
data/derived/*
!data/derived/.gitkeep
data/**/*.csv
data/**/*.parquet
data/**/*.feather
data/**/*.tsv
data/**/*.json
data/**/*.zip

# Saved model weights and binary artifacts
models/
artifacts/
*.pkl
*.joblib
*.model
*.ubj
*.h5
*.pt
*.pth
*.onnx

# Scratch and execution logs
logs/
*.log
scratch/

# LaTeX intermediate build artifacts (keep .tex, .bib, and final generated artifacts as needed)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.lof
*.lot

